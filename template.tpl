scenarios:
- name: Injects the ByAds script and queues the config
  code: |-
    mock('copyFromWindow', () => false);
    let injectedUrl = '';
    let cacheToken = '';
    mock('injectScript', (url, onSuccess, onFailure, token) => { injectedUrl = url; cacheToken = token; onSuccess(); });
    let queued = [];
    let queueName = '';
    mock('createQueue', (name) => { queueName = name; return (item) => { queued.push(item); }; });
    mock('logToConsole', () => {});

    runCode({
      clientId: 'test-client-123',
      eventType: 'page_view',
      sigEnv: true,
      sigPerf: true,
      sigConsent: true,
      sigIds: true,
      sigDl: true,
      sigEcom: true,
      debug: false
    });

    assertThat(injectedUrl).isEqualTo('https://pixel.byads.co/t/v1.js?client=test-client-123');
    assertThat(cacheToken).isEqualTo('advBeacon');
    assertThat(queueName).isEqualTo('__advBeaconInbox');
    assertThat(queued.length).isEqualTo(1);
    assertThat(queued[0].clientId).isEqualTo('test-client-123');
    assertThat(queued[0].endpoint).isEqualTo('https://pixel.byads.co');
    assertThat(queued[0].path).isEqualTo('/v1/beacon');
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('gtmOnFailure').wasNotCalled();
