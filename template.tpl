    mock('createQueue', () => (item) => { queued.push(item); });
    mock('logToConsole', () => {});

    runCode({
      clientId: 'test-client-123',
      eventType: 'page_view',
      sigIds: true,
      skipCampaign: true,
      skipAffiliate: true
    });

    assertThat(queued[0].signals.ids_config.skip_campaign).isTrue();
    assertThat(queued[0].signals.ids_config.skip_affiliate).isTrue();
    assertThat(queued[0].signals.ids_config.skip_click_ids).isFalse();


