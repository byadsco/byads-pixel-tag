___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const injectScript = require('injectScript');
const copyFromWindow = require('copyFromWindow');
const createQueue = require('createQueue');
const encodeUriComponent = require('encodeUriComponent');
const getType = require('getType');
const log = require('logToConsole');

const NS = '__advBeacon';
const INBOX = NS + 'Inbox';
const READY = '__advBeaconReady';

// Hardcoded configuration
const ENDPOINT = 'https://pixel.byads.co';
const PATH = '/v1/beacon';

// encodeUriComponent returns undefined for input it cannot encode.
const encodedClientId = encodeUriComponent(data.clientId);
if (!encodedClientId) {
  log('[ByAds Pixel] Invalid client ID');
  data.gtmOnFailure();
  return;
}

// Script URL includes client ID so the server can serve the correct
// profile (full/standard/lite/minimal/off) configured in the ByAds platform.
const SCRIPT_URL = ENDPOINT + '/t/v1.js?client=' + encodedClientId;

// Assemble beacon configuration from template fields
const beaconCfg = {
  clientId: data.clientId,
  endpoint: ENDPOINT,
  path: PATH,
  dataLayerName: data.dataLayerName || 'dataLayer',
  eventType: data.eventType || 'page_view',
  customEventName: data.customEventName || '',
  dedupKey: data.dedupKey || '',
  debug: data.debug || false,
  signals: {
    env: data.sigEnv !== false,
    perf: data.sigPerf !== false,
    consent: data.sigConsent !== false,
    ids: data.sigIds !== false,
    ids_config: {
      skip_click_ids: data.skipClickIds || false,
      skip_browser_ids: data.skipBrowserIds || false,
      skip_analytics: data.skipAnalyticsIds || false,
      skip_campaign: data.skipCampaign || false,
      skip_affiliate: data.skipAffiliate || false
    },
    dl: data.sigDl !== false,
    ecom: data.sigEcom !== false
  },
  customProps: data.customProps || [],
  userData: {
    email: data.userEmail || '',
    phone: data.userPhone || '',
    firstName: data.userFirstName || '',
    lastName: data.userLastName || '',
    city: data.userCity || '',
    state: data.userState || '',
    zip: data.userZip || '',
    country: data.userCountry || ''
  },
  userNorm: data.userNorm || 'raw'
};

// Check if beacon script is already loaded
const isReady = copyFromWindow(READY);

if (isReady) {
  const send = copyFromWindow(NS);
  if (getType(send) === 'function') {
    send(beaconCfg);
    data.gtmOnSuccess();
  } else {
    log('[ByAds Pixel] Ready flag set but dispatcher unavailable');
    data.gtmOnFailure();
  }
} else {
  // Queue config and inject script
  const inbox = createQueue(INBOX);
  inbox(beaconCfg);

  injectScript(SCRIPT_URL, function () {
    if (data.debug) {
      log('[ByAds Pixel] Script loaded');
    }
    data.gtmOnSuccess();
  }, function () {
    log('[ByAds Pixel] Failed to load script');
    data.gtmOnFailure();
  }, 'advBeacon');
}


